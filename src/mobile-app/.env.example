# Copy to .env and adjust. Base URL of the Fluent Audio Split API/gateway the
# built APK talks to. Baked into the APK at build time via
# --dart-define=API_BASE_URL (see tool/flutter.sh -> build-apk), so changing it
# requires rebuilding the APK.
#
# Examples:
#   https://smthsmth.org   # remote gateway (physical device / cloud emulator)
#   http://10.0.2.2:8765              # host's localhost as seen from a LOCAL Android emulator
#   http://<your-LAN-IP>:8765         # local stack from a physical phone on the same network
API_BASE_URL=https://smthsmth.org
