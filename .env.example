# Frontend
VITE_SERVICE_URL=http://localhost:8765

# Remote audio separator (leave empty to use local GPU separation)
AUDIO_SEPARATOR_API_URL=
AUDIO_SEPARATOR_API_KEY=

# YouTube import egress proxy (leave empty to connect directly).
# Datacenter/VPS IPs are often blocked by YouTube, so point this at a
# residential/trusted proxy (e.g. a home proxy reachable over your tailnet).
YOUTUBE_IMPORT_PROXY_URL=
